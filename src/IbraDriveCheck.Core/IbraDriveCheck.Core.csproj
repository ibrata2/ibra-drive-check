<Project Sdk="Microsoft.NET.Sdk">

  <!-- محرك الفحص: مكتبة مستقلة بدون أي حزم خارجية، حتى يمكن دمجها لاحقاً داخل IBRA CLEAN UP -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>IbraDriveCheck.Core</RootNamespace>
    <AssemblyName>IbraDriveCheck.Core</AssemblyName>
    <Version>1.2.0</Version>
    <Company>IBRAPROGRAM</Company>
    <Authors>Ibrahim Al-Khazraji</Authors>
    <Product>IBRA DRIVE CHECK</Product>
    <NoWarn>$(NoWarn);CA1416;SYSLIB1054</NoWarn>
  </PropertyGroup>

  <!-- على ويندوز نستخدم System.Management الرسمية من مايكروسوفت لـ WMI؛ على غير ويندوز (للاختبارات فقط) يبقى مسار COM الاحتياطي -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <DefineConstants>$(DefineConstants);HAS_SYSMGMT</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
