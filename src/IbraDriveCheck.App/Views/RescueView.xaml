<UserControl x:Class="IbraDriveCheck.App.Views.RescueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <l:BoolToVisibility x:Key="InvVis" Invert="True"/>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{l:T rescue.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T rescue.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" DisplayMemberPath="Display" IsEnabled="{Binding IsIdle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding SearchCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{l:T rescue.search}" Foreground="White"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{l:T rescue.steps}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T rescue.candidates}" Style="{StaticResource H2}"/>
                    <ListBox ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}" ItemContainerStyle="{StaticResource RowItem}" MinHeight="60">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding OpenCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="13" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{l:T rescue.open}" Foreground="White"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource BaseButton}" Command="{Binding RepairCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T rescue.repair}"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{l:T rescue.repairNote}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="12,5" Margin="10,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FlatCard}" Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ResultText}" LineHeight="22" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
