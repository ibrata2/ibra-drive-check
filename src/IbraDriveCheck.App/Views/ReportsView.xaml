<UserControl x:Class="IbraDriveCheck.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
            <TextBlock Text="{l:T rep.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T rep.choose}" Style="{StaticResource Muted}"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="Items" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource RowItem}" SelectionChanged="OnSelect">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding DriveName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{Binding VerdictBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button Style="{StaticResource AccentButton}" Click="OnPdf" Margin="0,0,8,8" Padding="14,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA90;" Foreground="White" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T rep.pdf}" Foreground="White"/></StackPanel>
                    </Button>
                    <Button Click="OnPrint" Margin="0,0,8,8" Padding="14,8">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE749;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T rep.print}"/></StackPanel>
                    </Button>
                    <Button Click="OnHtml" Margin="0,0,8,8" Padding="14,8" Content="{l:T rep.html}"/>
                    <Button Click="OnCsv" Margin="0,0,8,8" Padding="14,8" Content="{l:T rep.csv}"/>
                    <Button Click="OnJson" Margin="0,0,8,8" Padding="14,8" Content="{l:T rep.json}"/>
                </WrapPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Preview">
                        <Border x:Name="VerdictBox" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="VerdictTitle" Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="VerdictHint" Foreground="White" Opacity="0.92"/>
                            </StackPanel>
                        </Border>
                        <ItemsControl x:Name="SummaryRows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.8*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NotesTitle" Text="{l:T res.notes}" Style="{StaticResource H2}" Margin="0,14,0,6"/>
                        <ItemsControl x:Name="NotesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{l:T rep.map}" Style="{StaticResource H2}" Margin="0,14,0,6"/>
                        <c:ScanMapControl x:Name="MapView" MaxCellSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
