<UserControl x:Class="IbraDriveCheck.App.Views.FakeDetectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <DataTemplate x:Key="CheckTemplate">
            <Border Style="{StaticResource FlatCard}" Margin="0,0,0,8">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{Binding Color}" Margin="0,0,12,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="White" FontSize="15" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{Binding Color}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">
            <TextBlock Text="{l:T fake.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T fake.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16" MaxWidth="980" HorizontalAlignment="Left"/>

            <ComboBox ItemsSource="{Binding Main.Drives}" SelectedItem="{Binding Main.SelectedDrive}" DisplayMemberPath="Display"
                      IsEnabled="{Binding IsNotRunning}" Margin="0,0,0,14" MaxWidth="720" HorizontalAlignment="Left" MinWidth="460"/>

            <!-- الفحص الشامل للشراء -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="16" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" Foreground="White" FontSize="24" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T adv.title}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{l:T adv.subtitle}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Content="{l:T adv.compatToggle}" IsChecked="{Binding CheckCompatibility}" IsEnabled="{Binding IsNotRunning}" Margin="0,14,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding RunCommand}" Padding="24,11" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T adv.run}" Foreground="White" FontSize="14.5"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="18,11"/>
                    </WrapPanel>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{Binding StepText}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- تقرير الشراء -->
            <Grid Visibility="{Binding HasResult, Converter={StaticResource Vis}}" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{l:T adv.report}" Style="{StaticResource H2}"/>
                        <Border CornerRadius="14" Padding="18,14" Background="{Binding LevelBrush}" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding LevelGlyph}" Foreground="White" FontSize="30" Margin="0,0,16,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding LevelText}" Foreground="White" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding LevelHint}" Foreground="White" Opacity="0.92" MaxWidth="520"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Checks}" ItemTemplate="{StaticResource CheckTemplate}"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding HasCompat, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{l:T adv.compatTitle}" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding Compat}" ItemTemplate="{StaticResource CheckTemplate}"/>
                            <TextBlock Text="{l:T adv.systemTitle}" Style="{StaticResource H2}" Margin="0,10,0,6"/>
                            <ItemsControl ItemsSource="{Binding SystemRows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{l:T scan.map}" Style="{StaticResource H2}"/>
                            <c:ScanMapControl LiveMap="{Binding LiveMap}" Records="{Binding Records}" Version="{Binding MapVersion}" MaxCellSize="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- خريطة مباشرة أثناء الفحص -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="{l:T scan.map}" Style="{StaticResource H2}"/>
                    <c:ScanMapControl LiveMap="{Binding LiveMap}" Records="{Binding Records}" Version="{Binding MapVersion}"/>
                </StackPanel>
            </Border>

            <!-- فحوصات منفردة -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T fake.step1}" Margin="0,2"/>
                    <TextBlock Text="{l:T fake.step2}" Margin="0,2"/>
                    <TextBlock Text="{l:T fake.step3}" Margin="0,2,0,12"/>
                    <WrapPanel>
                        <Button Click="OnQuick" Margin="0,0,10,0" Padding="18,9" IsEnabled="{Binding IsNotRunning}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T fake.quick}"/></StackPanel>
                        </Button>
                        <Button Click="OnDeep" Margin="0,0,10,0" Padding="18,9" IsEnabled="{Binding IsNotRunning}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T fake.deep}"/></StackPanel>
                        </Button>
                        <Button Click="OnFull" Padding="18,9" IsEnabled="{Binding IsNotRunning}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T fake.full}"/></StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
