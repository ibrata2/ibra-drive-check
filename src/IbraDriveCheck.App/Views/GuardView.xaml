<UserControl x:Class="IbraDriveCheck.App.Views.GuardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <l:BoolToVisibility x:Key="InvVis" Invert="True"/>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{l:T guard.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T guard.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}" DisplayMemberPath="Display" IsEnabled="{Binding IsIdle}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{l:T guard.scan}" Foreground="White"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource BaseButton}" Command="{Binding VaccinateCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T guard.vaccinate}"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource BaseButton}" Command="{Binding QuarantineCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T guard.quarantine}"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T guard.found}" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Threats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,0,6" Padding="10,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/><Run Text="  "/><Run Text="{Binding Detail, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox IsChecked="{Binding Vaccinate}" Content="{l:T guard.alsoVaccinate}" Margin="0,8,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding CleanCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{l:T guard.clean_btn}" Foreground="White"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{l:T guard.note}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="12,5" Margin="10,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FlatCard}" Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ResultText}" LineHeight="22" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
