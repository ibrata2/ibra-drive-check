<UserControl x:Class="IbraDriveCheck.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <l:BoolToVisibility x:Key="InvVis" Invert="True"/>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{l:T compare.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T compare.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>
            <ComboBox ItemsSource="{Binding Main.Drives}" SelectedItem="{Binding Main.SelectedDrive}" DisplayMemberPath="Display" IsEnabled="{Binding IsIdle}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{l:T compare.readPct}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Column="1" Value="{Binding ReadPercent, Mode=OneWay}" Maximum="100" Margin="8,6"/>
                        <TextBlock Grid.Column="2" Text="{Binding ReadText}" FontWeight="Bold" FlowDirection="LeftToRight"/>
                        <TextBlock Grid.Row="1" Text="{l:T compare.writePct}" VerticalAlignment="Center"/>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Value="{Binding WritePercent, Mode=OneWay}" Maximum="100" Margin="8,6"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding WriteText}" FontWeight="Bold" FlowDirection="LeftToRight"/>
                    </Grid>
                    <TextBlock Text="{Binding HintText}" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <Button Command="{Binding SpeedCommand}" Content="{l:T compare.runSpeed}" HorizontalAlignment="Left" Padding="14,7" Margin="0,12,0,0"/>
                    <TextBlock Text="{l:T compare.disclaimer}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="12,5" Margin="10,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FlatCard}" Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ResultText}" LineHeight="22" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
