<UserControl x:Class="IbraDriveCheck.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{l:T hist.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T hist.compareHint}" Style="{StaticResource Muted}" Margin="0,0,0,12"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <Button Click="OnCompare" Margin="0,0,10,0" Padding="14,8">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T hist.compare}"/></StackPanel>
            </Button>
            <Button Click="OnReport" Margin="0,0,10,0" Padding="14,8">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T nav.reports}"/></StackPanel>
            </Button>
            <Button Click="OnDelete" Margin="0,0,10,0" Padding="14,8">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T hist.deleteSel}"/></StackPanel>
            </Button>
            <Button Style="{StaticResource DangerOutlineButton}" Click="OnDeleteAll" Padding="14,8" Content="{l:T hist.deleteAll}"/>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <TextBlock x:Name="EmptyText" Text="{l:T hist.empty}" Style="{StaticResource Muted}" FontSize="14" Margin="12" Visibility="Collapsed"/>
                <ListBox x:Name="HistList" ItemsSource="{Binding Items}" SelectionMode="Extended" ItemContainerStyle="{StaticResource RowItem}" MouseDoubleClick="OnReport">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding DriveName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding KindText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,8,0"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{Binding VerdictBrush}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding VerdictText}" Foreground="{Binding VerdictBrush}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{Binding CapacityText}" VerticalAlignment="Center" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border x:Name="ComparePanel" Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{l:T common.close}" Click="OnCloseCompare" Padding="12,5"/>
                    <TextBlock Text="{l:T hist.compare}" Style="{StaticResource H2}"/>
                </DockPanel>
                <ItemsControl x:Name="CompareRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding A}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding B}" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
