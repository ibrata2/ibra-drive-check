<UserControl x:Class="IbraDriveCheck.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{l:T about.title}" Style="{StaticResource H1}" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Image Source="pack://application:,,,/IbraDriveCheck;component/Assets/icon.png" Width="88" Height="88" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="IBRA DRIVE CHECK" FontSize="26" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                            <TextBlock Text="{l:T app.tagline}" Style="{StaticResource Muted}" FontSize="13"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{l:T about.desc}" FontSize="13.5" LineHeight="22" Margin="0,0,0,14"/>
                    <Border Style="{StaticResource FlatCard}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="#16A34A" Margin="0,0,10,0"/>
                            <TextBlock Text="{l:T about.free}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{l:T about.credit}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource AccentButton}" Click="OnSite" Margin="0,0,10,10" Padding="16,9">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="White" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T about.site}" Foreground="White"/></StackPanel>
                        </Button>
                        <Button Click="OnTelegram" Margin="0,0,10,10" Padding="16,9">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T about.telegram}"/></StackPanel>
                        </Button>
                        <Button Click="OnTikTok" Margin="0,0,10,10" Padding="16,9">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B2;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T about.tiktok}"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="https://ibraprogram.netlify.app/" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        <TextBlock Text="https://t.me/ibraprogram" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        <TextBlock Text="TikTok: ibraprogram" Style="{StaticResource Muted}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
