<UserControl x:Class="IbraDriveCheck.App.Views.LifeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <l:BoolToVisibility x:Key="InvVis" Invert="True"/>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{l:T life.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T life.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>
            <ComboBox ItemsSource="{Binding Main.Drives}" SelectedItem="{Binding Main.SelectedDrive}" DisplayMemberPath="Display" IsEnabled="{Binding IsIdle}" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{l:T life.health}" Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding HealthText}" FontSize="54" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" FlowDirection="LeftToRight"/>
                        <ProgressBar Value="{Binding HealthPercent, Mode=OneWay}" Maximum="100" Width="220" Margin="0,4,0,12"/>
                        <TextBlock Text="{Binding YearsText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Button Style="{StaticResource BaseButton}" Command="{Binding ReadCommand}" Padding="18,9" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T common.refresh}"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                        <TextBlock Text="{Binding NoteText}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="12,5" Margin="10,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FlatCard}" Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ResultText}" LineHeight="22" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
