<UserControl x:Class="IbraDriveCheck.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="{l:T tools.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T tools.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>

            <ComboBox ItemsSource="{Binding Main.Drives}" SelectedItem="{Binding Main.SelectedDrive}" DisplayMemberPath="Display"
                      IsEnabled="{Binding IsIdle}" Margin="0,0,0,14"/>

            <Border Style="{StaticResource FlatCard}" Background="{DynamicResource DangerBgBrush}" Margin="0,0,0,14"
                    Visibility="{Binding IsBlocked, Converter={StaticResource Vis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding BlockedText}" MaxWidth="860"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,-12,0">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{l:T res.declared}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding DeclaredText}" Style="{StaticResource StatValue}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{l:T tools.real}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding RealText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <TextBlock Text="{l:T tools.recommended}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding RecommendedText}" Style="{StaticResource StatValue}" Foreground="#16A34A" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource FlatCard}" Background="{DynamicResource WarningBgBrush}" Margin="0,0,0,14"
                    Visibility="{Binding NoScan, Converter={StaticResource Vis}}">
                <TextBlock Text="{l:T tools.scanFirst}"/>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T tools.size}" Style="{StaticResource H2}"/>
                    <RadioButton GroupName="mode" IsChecked="{Binding ModeRecommended}" Content="{l:T tools.modeRecommended}"/>
                    <RadioButton GroupName="mode" IsChecked="{Binding ModeFull}" Content="{l:T tools.modeFull}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="mode" IsChecked="{Binding ModeCustom}" Content="{l:T tools.modeCustom}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CustomGB, UpdateSourceTrigger=PropertyChanged}" Width="110" IsEnabled="{Binding ModeCustom}" FlowDirection="LeftToRight"/>
                        <TextBlock Text="GB" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0">
                        <Run Text="{l:T tools.target}"/><Run Text=": "/><Run Text="{Binding TargetText, Mode=OneWay}" FontWeight="Bold"/>
                    </TextBlock>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T info.fs}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding SelectedFs}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T tools.label}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" MaxLength="32"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox Content="{l:T tools.verifyAfter}" IsChecked="{Binding VerifyAfter}" Margin="0,14,0,0"/>
                    <TextBlock Text="{l:T tools.note}" Style="{StaticResource Muted}" Margin="0,12,0,14"/>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Padding="22,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE90F;" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T tools.apply}" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}"/>
                    <TextBlock Text="{Binding LogText}" Margin="0,12,0,0" FontFamily="Consolas, Segoe UI" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
