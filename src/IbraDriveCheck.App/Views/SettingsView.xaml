<UserControl x:Class="IbraDriveCheck.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="{l:T set.title}" Style="{StaticResource H1}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T set.language}" Style="{StaticResource H2}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LangAr" Content="العربية" GroupName="lang" Checked="OnLang"/>
                        <RadioButton x:Name="LangEn" Content="English" GroupName="lang" Checked="OnLang"/>
                    </StackPanel>
                    <TextBlock Text="{l:T set.theme}" Style="{StaticResource H2}" Margin="0,16,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeLight" Content="{l:T set.light}" GroupName="theme" Checked="OnTheme"/>
                        <RadioButton x:Name="ThemeDark" Content="{l:T set.dark}" GroupName="theme" Checked="OnTheme"/>
                        <RadioButton x:Name="ThemeSystem" Content="{l:T set.system}" GroupName="theme" Checked="OnTheme"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{l:T set.notifications}" Style="{StaticResource H2}"/>
                    <CheckBox x:Name="NNew" Content="{l:T set.nNewDrive}" Click="OnNotify"/>
                    <CheckBox x:Name="NDone" Content="{l:T set.nDone}" Click="OnNotify"/>
                    <CheckBox x:Name="NFake" Content="{l:T set.nFake}" Click="OnNotify"/>
                    <CheckBox x:Name="NErrors" Content="{l:T set.nErrors}" Click="OnNotify"/>
                    <CheckBox x:Name="NHot" Content="{l:T set.nHot}" Click="OnNotify"/>
                    <CheckBox x:Name="NDisconnect" Content="{l:T set.nDisconnect}" Click="OnNotify"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T set.data}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{l:T set.privacy}" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Click="OnOpenData" Margin="0,0,10,0" Padding="14,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T set.openData}"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerOutlineButton}" Click="OnDeleteAll" Padding="14,8" Content="{l:T hist.deleteAll}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
