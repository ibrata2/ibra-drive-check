<Window x:Class="IbraDriveCheck.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
        Title="IBRA DRIVE CHECK" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBgBrush}"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}">
    <Border Padding="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock x:Name="IconText" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="28" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="{l:T scan.confirmTitle}" Style="{StaticResource H2}" Margin="0"/>
                    <TextBlock x:Name="KindText" Style="{StaticResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <Border Style="{StaticResource FlatCard}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" Margin="0,0,10,0"/>
                    <TextBlock x:Name="DriveText" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="MessageText" LineHeight="22" Margin="0,0,0,12"/>
            <StackPanel x:Name="TypedPanel" Visibility="Collapsed" Margin="0,0,0,12">
                <TextBlock x:Name="TypedHint" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,6" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                <TextBox x:Name="TypedBox" TextChanged="OnChanged" FlowDirection="LeftToRight"/>
            </StackPanel>
            <CheckBox x:Name="BackupCheck" Content="{l:T scan.confirmBackup}" Checked="OnChanged" Unchecked="OnChanged" Margin="0,0,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T common.cancel}" IsCancel="True" Margin="0,0,10,0" MinWidth="110"/>
                <Button x:Name="GoButton" Content="{l:T scan.confirmGo}" Style="{StaticResource AccentButton}" IsEnabled="False" Click="OnGo" MinWidth="140"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
