<UserControl x:Class="IbraDriveCheck.App.Views.WipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="{l:T wipe.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T wipe.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>

            <!-- إزالة آثار المحذوفات من قسم -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:T wipe.volumeTitle}" Style="{StaticResource H2}"/>
                    <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}" DisplayMemberPath="Display" IsEnabled="{Binding IsIdle}" Margin="0,0,0,12"/>
                    <CheckBox IsChecked="{Binding ScrubNames}" IsEnabled="{Binding IsIdle}">
                        <StackPanel>
                            <TextBlock Text="{l:T wipe.optNames}" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T wipe.optNamesDesc}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding WipeFree}" IsEnabled="{Binding IsIdle}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{l:T wipe.optFree}" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T wipe.optFreeDesc}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding DeleteUsn}" IsEnabled="{Binding IsIdle}" Margin="0,8,0,0" Visibility="{Binding IsNtfs, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{l:T wipe.optUsn}" FontWeight="SemiBold"/>
                            <TextBlock Text="{l:T wipe.optUsnDesc}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </CheckBox>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" Padding="20,9" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE75C;" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T wipe.start}" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding VerifyCommand}" Content="{l:T wipe.verifyBtn}" Padding="14,9" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="14,9"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- الحذف الآمن -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{l:T wipe.shredTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{l:T wipe.shredDesc}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <WrapPanel Margin="0,0,0,8">
                        <Button Command="{Binding AddFilesCommand}" Content="{l:T wipe.addFiles}" Padding="12,7" Margin="0,0,8,0"/>
                        <Button Command="{Binding AddFolderCommand}" Content="{l:T wipe.addFolder}" Padding="12,7" Margin="0,0,8,0"/>
                        <Button Command="{Binding RemoveCommand}" Content="{l:T common.delete}" Padding="12,7"/>
                    </WrapPanel>
                    <Border Style="{StaticResource FlatCard}" MinHeight="90" MaxHeight="220" Padding="4">
                        <ListBox ItemsSource="{Binding ShredList}" SelectedItem="{Binding SelectedShred}" ItemContainerStyle="{StaticResource RowItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <CheckBox Content="{l:T wipe.threePasses}" IsChecked="{Binding ThreePasses}" Margin="0,10,0,0"/>
                    <Button Style="{StaticResource AccentButton}" Command="{Binding ShredCommand}" HorizontalAlignment="Left" Padding="20,9" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T wipe.shredBtn}" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FlatCard}" Visibility="{Binding ResultText, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ResultText}" LineHeight="22"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
