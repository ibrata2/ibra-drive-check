<UserControl x:Class="IbraDriveCheck.App.Views.SpeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <DataTemplate x:Key="Tile">
            <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Main}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="12"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">
            <TextBlock Text="{l:T speed.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T speed.hint}" Style="{StaticResource Muted}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:T common.selectDrive}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Main.Drives}" SelectedItem="{Binding Main.SelectedDrive}" DisplayMemberPath="Display" IsEnabled="{Binding IsNotRunning}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:T speed.volume}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}" DisplayMemberPath="Letter" IsEnabled="{Binding IsNotRunning}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{l:T speed.size}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding SelectedSize}" ItemStringFormat="{}{0} MB" IsEnabled="{Binding IsNotRunning}"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding StartCommand}" Padding="22,10" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T common.start}" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="16,10"/>
                    </WrapPanel>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LiveText}" FontWeight="Bold" FlowDirection="LeftToRight"/>
                            <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold"/>
                        </DockPanel>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"/>
                    </StackPanel>
                    <TextBlock Text="{Binding VerdictText}" Margin="0,12,0,0" Visibility="{Binding VerdictText, Converter={StaticResource Vis}}"/>
                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,-12,0">
                <ContentControl Content="{Binding SeqRead}" ContentTemplate="{StaticResource Tile}"/>
                <ContentControl Content="{Binding SeqWrite}" ContentTemplate="{StaticResource Tile}"/>
                <ContentControl Content="{Binding RandRead}" ContentTemplate="{StaticResource Tile}"/>
                <ContentControl Content="{Binding RandWrite}" ContentTemplate="{StaticResource Tile}"/>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Width="14" Height="4" Background="#3B82F6" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T speed.seqRead}" FontSize="12" Margin="0,0,14,0"/>
                            <Border Width="14" Height="4" Background="#E60012" CornerRadius="2" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:T speed.seqWrite}" FontSize="12"/>
                        </StackPanel>
                        <TextBlock Text="MB/s" Style="{StaticResource H2}" Margin="0"/>
                    </DockPanel>
                    <c:SpeedChart Height="220" ReadSamples="{Binding ReadSamples}" WriteSamples="{Binding WriteSamples}" Version="{Binding ChartVersion}"
                                  AxisBrush="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
