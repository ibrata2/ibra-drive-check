<UserControl x:Class="IbraDriveCheck.App.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:vm="clr-namespace:IbraDriveCheck.App.ViewModels">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <l:BoolToVisibility x:Key="InvVis" Invert="True"/>
    </UserControl.Resources>
    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T rec.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T rec.intro}" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,0,0,12"/>
        </StackPanel>

        <!-- اختيار القسم ونوع البحث -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ScanCommand}" Padding="18,9" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T rec.scan}" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="14,9"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}" DisplayMemberPath="Display" IsEnabled="{Binding IsIdle}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton GroupName="m" IsChecked="{Binding Quick}" Content="{l:T rec.quick}" IsEnabled="{Binding IsIdle}"/>
                    <RadioButton GroupName="m" IsChecked="{Binding Deep}" Content="{l:T rec.deep}" IsEnabled="{Binding IsIdle}"/>
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight"/>
                        <TextBlock Text="{Binding StatusText}"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
                <TextBlock Text="{Binding SummaryText}" FontWeight="SemiBold" Margin="0,10,0,0" Visibility="{Binding SummaryText, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </Border>

        <!-- التصفية -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,8" Visibility="{Binding HasResults, Converter={StaticResource Vis}}">
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="240" Margin="0,0,10,6" ToolTip="{l:T rec.filter}"/>
            <ComboBox ItemsSource="{Binding Types}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding SelectedType}" Width="170" Margin="0,0,10,6"/>
            <CheckBox Content="{l:T rec.onlyGood}" IsChecked="{Binding OnlyGood}" Margin="0,0,14,6" VerticalAlignment="Center"/>
            <Button Command="{Binding SelectAllCommand}" Content="{l:T rec.selectAll}" Padding="12,6" Margin="0,0,8,6"/>
            <Button Command="{Binding SelectNoneCommand}" Content="{l:T rec.selectNone}" Padding="12,6" Margin="0,0,8,6"/>
        </WrapPanel>

        <!-- الشجرة -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6">
            <Grid>
                <TextBlock Text="{l:T rec.empty}" Style="{StaticResource Muted}" FontSize="13" Margin="12" Visibility="{Binding HasResults, Converter={StaticResource InvVis}}"/>
                <TreeView ItemsSource="{Binding Roots}" Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="Padding" Value="2"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:RecNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="False" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Ellipse Width="8" Height="8" Fill="{Binding ChanceBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" TextWrapping="NoWrap" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- الاستعادة -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Ellipse Width="9" Height="9" Fill="{StaticResource CellGood}" Margin="0,0,6,0"/><TextBlock Text="{l:T rec.chance.Good}" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Ellipse Width="9" Height="9" Fill="{StaticResource CellSlow}" Margin="0,0,6,0"/><TextBlock Text="{l:T rec.chance.Partial}" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Ellipse Width="9" Height="9" Fill="{StaticResource CellFailed}" Margin="0,0,6,0"/><TextBlock Text="{l:T rec.chance.Poor}" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Ellipse Width="9" Height="9" Fill="{StaticResource CellTesting}" Margin="0,0,6,0"/><TextBlock Text="{l:T rec.chance.Carved}" FontSize="12"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,4"><Ellipse Width="9" Height="9" Fill="{StaticResource CellUntested}" Margin="0,0,6,0"/><TextBlock Text="{l:T rec.chance.Unsupported}" FontSize="12"/></StackPanel>
                </WrapPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding RecoverCommand}" Padding="20,9" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T rec.recover}" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Command="{Binding BrowseCommand}" Content="{l:T rec.browse}" Padding="12,8" Margin="10,0,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="{l:T rec.output}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                </DockPanel>
                <TextBlock Text="{l:T rec.warn}" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
