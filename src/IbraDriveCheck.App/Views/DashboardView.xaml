<UserControl x:Class="IbraDriveCheck.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <l:BoolToVisibility x:Key="InvVis" Invert="True"/>
        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinWidth" Value="180"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Click="OnRefresh" Padding="12,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T common.refresh}"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{l:T nav.dashboard}" Style="{StaticResource H1}"/>
                    <TextBlock Text="{l:T app.tagline}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{l:T dash.quick}" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,18">
                <Button Tag="fake" Click="OnQuick" Margin="0,0,10,10" Padding="16,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C7;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T quick.purchase}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="recovery" Click="OnQuick" Margin="0,0,10,10" Padding="16,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T quick.recovery}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="rescue" Click="OnQuick" Margin="0,0,10,10" Padding="16,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9CE;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T quick.rescue}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="guard" Click="OnQuick" Margin="0,0,10,10" Padding="16,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T quick.guard}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="eject" Click="OnQuick" Margin="0,0,10,10" Padding="16,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xF847;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T quick.eject}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Tag="speed" Click="OnQuick" Margin="0,0,10,10" Padding="16,12" MinWidth="150">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEC4A;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="{l:T quick.speed}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>

            <UniformGrid Columns="3" Margin="0,0,-12,0">
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T dash.connected}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding StatConnected}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="12" Background="#1A16A34A" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="#16A34A" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T dash.healthy}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding StatHealthy}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="12" Background="#1ACA8A04" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="#CA8A04" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T dash.suspicious}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding StatSuspicious}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xEA39;" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T dash.fake}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding StatFake}" Style="{StaticResource StatValue}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="12" Background="#1A3B82F6" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T dash.totalScans}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding StatTotalScans}" Style="{StaticResource StatValue}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource StatCard}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="40" Height="40" CornerRadius="12" Background="#1A16A34A" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" Foreground="#16A34A" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{l:T dash.verified}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding StatVerified}" Style="{StaticResource StatValue}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{l:T dash.drives}" Style="{StaticResource H2}" Margin="0,14,0,10"/>
            <Border Style="{StaticResource Card}" Visibility="{Binding StatConnected, Converter={StaticResource InvVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" FontSize="22" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,14,0"/>
                    <TextBlock Text="{l:T common.noDrives}" Style="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="330" Margin="0,0,14,14">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{l:T info.declared}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding SizeText}" FontWeight="Bold" FontSize="18"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{l:T info.letters}" Style="{StaticResource Muted}"/>
                                        <TextBlock Text="{Binding Letters}" FontWeight="Bold" FontSize="18"/>
                                    </StackPanel>
                                </Grid>
                                <Border CornerRadius="10" Padding="10,8" Margin="0,12,0,12" Background="{DynamicResource SurfaceAltBrush}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Fill="{Binding LastBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding LastText}" FontWeight="SemiBold" Foreground="{Binding LastBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastDetail}" Style="{StaticResource Muted}" Margin="17,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource AccentButton}" Click="OnScan" Tag="{Binding}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="{l:T dash.scanNow}" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
