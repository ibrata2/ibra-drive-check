<UserControl x:Class="IbraDriveCheck.App.Views.WriteLockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <l:BoolToVisibility x:Key="InvVis" Invert="True"/>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{l:T lock.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T lock.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>
            <ComboBox ItemsSource="{Binding Main.Drives}" SelectedItem="{Binding Main.SelectedDrive}" DisplayMemberPath="Display" IsEnabled="{Binding IsIdle}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{l:T lock.driveTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Margin="0,0,0,12"><Run Text="{l:T info.wp}"/><Run Text=": "/><Run Text="{Binding DriveState, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                    <WrapPanel>
                        <Button Style="{StaticResource AccentButton}" Command="{Binding LockCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Foreground="White" Margin="0,0,8,0"/><TextBlock Text="{l:T lock.lock}" Foreground="White"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource BaseButton}" Command="{Binding UnlockCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE785;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T lock.unlock}"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{l:T lock.driveNote}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T lock.policyTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding PolicyState}" FontWeight="Bold" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button Style="{StaticResource BaseButton}" Command="{Binding PolicyOnCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T lock.policyEnable}"/></StackPanel>
                        </Button>
                        <Button Style="{StaticResource BaseButton}" Command="{Binding PolicyOffCommand}" Padding="18,9" Margin="0,0,10,8">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE785;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T lock.policyDisable}"/></StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="{l:T lock.policyNote}" Style="{StaticResource Muted}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="12,5" Margin="10,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FlatCard}" Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ResultText}" LineHeight="22" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
