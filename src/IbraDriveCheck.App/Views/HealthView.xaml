<UserControl x:Class="IbraDriveCheck.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure">
    <UserControl.Resources>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Highlight}" Value="True">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,28">
            <TextBlock Text="{l:T health.title}" Style="{StaticResource H1}"/>
            <DockPanel Margin="0,10,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding ReadCommand}" Margin="10,0,0,0" Padding="18,9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE95E;" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="{l:T health.read}" Foreground="White"/>
                    </StackPanel>
                </Button>
                <ComboBox ItemsSource="{Binding Main.Drives}" SelectedItem="{Binding Main.SelectedDrive}" DisplayMemberPath="Display" IsEnabled="{Binding IsNotLoading}"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Messages}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FlatCard}" Background="{DynamicResource WarningBgBrush}" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding}" MaxWidth="900"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{l:T scan.driveInfo}" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding InfoRows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SMART / NVMe" Style="{StaticResource H2}"/>
                        <ItemsControl ItemsSource="{Binding HealthRows}" ItemTemplate="{StaticResource InfoRowTemplate}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
