<UserControl x:Class="IbraDriveCheck.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:IbraDriveCheck.App.Infrastructure"
             xmlns:c="clr-namespace:IbraDriveCheck.App.Controls">
    <UserControl.Resources>
        <l:BoolToVisibility x:Key="Vis"/>
        <l:BoolToVisibility x:Key="InvVis" Invert="True"/>
        <DataTemplate x:Key="InfoRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,10,28,28" MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="{l:T monitor.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{l:T monitor.intro}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,0,16"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox IsChecked="{Binding Enabled}"><TextBlock Text="{l:T monitor.enable}" FontWeight="SemiBold"/></CheckBox>
                    <CheckBox IsChecked="{Binding StartWithWindows}" Margin="0,8,0,0"><TextBlock Text="{l:T monitor.startup}"/></CheckBox>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{l:T monitor.limit}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Limits}" SelectedItem="{Binding TempLimit}" ItemStringFormat="{}{0} °C" Width="110" Margin="0,0,20,0"/>
                        <TextBlock Text="{l:T monitor.every}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}" ItemStringFormat="{}{0} min" Width="110"/>
                    </StackPanel>
                    <TextBlock Text="{l:T monitor.note}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Command="{Binding CheckCommand}" Content="{l:T monitor.check}" Padding="12,6"/>
                        <TextBlock Text="{l:T monitor.now}" Style="{StaticResource H2}" Margin="0"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Temp}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource Muted}" FlowDirection="LeftToRight"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerOutlineButton}" Command="{Binding CancelCommand}" Content="{l:T common.cancel}" Padding="12,5" Margin="10,0,0,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressPercent, StringFormat={}{0:0.0}%}" FontWeight="Bold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FlatCard}" Margin="0,14,0,0" Visibility="{Binding HasResult, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding ResultText}" LineHeight="22" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
