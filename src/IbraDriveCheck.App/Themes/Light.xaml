<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- الهوية: أحمر IBRA على زجاج فاتح -->
    <Color x:Key="AccentColor">#E60012</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#E60012"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF1F33"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B8000E"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#16E60012"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF6F7" Offset="0"/>
        <GradientStop Color="#FFFFFF" Offset="0.45"/>
        <GradientStop Color="#FCEBEE" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBrush" Color="#B8FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#D9FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F2FAFAFA"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1A000000"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#0F000000"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1AE60012"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#1AF59E0B"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#14E60012"/>
    <Color x:Key="ShadowColor">#30000000</Color>
</ResourceDictionary>
