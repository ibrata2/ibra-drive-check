<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- الهوية: أحمر IBRA على زجاج أسود -->
    <Color x:Key="AccentColor">#FF1F33</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#E60012"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF2A3D"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#B8000E"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26E60012"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <LinearGradientBrush x:Key="WindowBgBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D0B0C" Offset="0"/>
        <GradientStop Color="#141012" Offset="0.5"/>
        <GradientStop Color="#220C10" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBrush" Color="#B3141213"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#C21E1B1D"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#E6262224"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FF242023"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#33E60012"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#00000000"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="WarningBgBrush" Color="#26F59E0B"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#26E60012"/>
    <Color x:Key="ShadowColor">#70000000</Color>
</ResourceDictionary>
