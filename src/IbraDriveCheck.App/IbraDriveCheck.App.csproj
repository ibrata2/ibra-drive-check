<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>IbraDriveCheck</AssemblyName>
    <RootNamespace>IbraDriveCheck.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>IBRA DRIVE CHECK</Product>
    <AssemblyTitle>IBRA DRIVE CHECK</AssemblyTitle>
    <Description>IBRA DRIVE CHECK — storage verification and fake capacity detection</Description>
    <Company>IBRAPROGRAM</Company>
    <Authors>Ibrahim Al-Khazraji</Authors>
    <Copyright>© Ibrahim Al-Khazraji — ibraprogram.netlify.app</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
    <!-- النسخة المنشورة: ملف واحد مستقل (لا يحتاج تثبيت .NET) بدون UPX أو أي تمويه -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- نستخدم WinForms فقط لأيقونة الإشعارات؛ نمنع الـ usings العامة حتى لا تتعارض أسماء WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IbraDriveCheck.Core\IbraDriveCheck.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.png" Link="Assets\icon.png" />
  </ItemGroup>

</Project>
